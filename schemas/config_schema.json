{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoDevOps Configuration",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "web_server",
              "database",
              "network"
            ]
          },
          "provider": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "instance_type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
